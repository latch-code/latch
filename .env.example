# Optional startup overrides. Copy to .env and load it with your shell; never commit real keys.
# A model service set here is used for this run only and is not saved to the data directory.
LATCH_BASE_URL=
LATCH_MODEL=
LATCH_API_KEY=
# Defaults: data dir ~/Library/Application Support/Latch/Host on macOS (an existing ./.runtime is still used),
# port 4317, workspace ~/Latch/workspace. LATCH_BASE_URL must not contain credentials, a query or a fragment.
LATCH_DATA_DIR=
LATCH_PORT=
LATCH_WORKSPACE=
