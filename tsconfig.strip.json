// Modules that Node loads with type stripping alone: the Cursor SDK runner from the package sources, and Host modules: apps/web/vite.config.ts imports them as @latch/host/paths,
// @latch/host/host-state and @latch/host/env, the root vitest.config.ts imports @latch/host/env, and Vite leaves a
// bundled config's package imports to Node. erasableSyntaxOnly rejects the syntax Node cannot strip (enums, namespaces,
// constructor parameter properties) in them and in what they import; the rest of the Host is checked by
// tsconfig.host.json without it.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/strip.tsbuildinfo"
  },
  "files": [
    "apps/host/src/paths.ts",
    "apps/host/src/host-state.ts",
    "apps/host/src/env.ts",
    "packages/harness-acp/src/cursor-runner.ts",
    "packages/harness-acp/src/claude-store-runner.ts"
  ]
}
