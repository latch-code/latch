{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  // `pnpm knip` fails on imports of packages a project does not declare (unlisted) and on imports that do not resolve;
  // every other finding is only reported for now. Its second pass, --strict, checks each project's production code
  // against that project's own `dependencies`: the default pass also accepts a package declared by the root, as Node
  // does when it walks up to the root node_modules, so it alone would not catch a package that relies on the root.
  "rules": {
    "unlisted": "error",
    "unresolved": "error",
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "optionalPeerDependencies": "warn",
    "binaries": "warn",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "duplicates": "warn",
    "enumMembers": "warn",
    "namespaceMembers": "warn",
    "catalog": "warn",
    "catalogReferences": "warn"
  },
  "workspaces": {
    ".": {
      "entry": ["examples/*.mjs"],
      // lefthook runs by hand once per clone (`pnpm exec lefthook install`), not from a script. qrcode and undici are
      // imported only by workspace projects (qrcode by the Host and the web client, undici by the Host, the Claude Agent
      // SDK by harness-acp); the Host bundles in dist/ load them from the root's node_modules, so the root declares them too.
      // @types/react: the Host type-checks page drafts against it at run time (app-build.ts); dist/ resolves it from the root.
      // @cursor/sdk: dist/harness/cursor-runner.js imports it at run time from the root's node_modules; the Claude Agent SDK
      // is imported by harness-acp and loaded by the Host bundle from there too.
      "ignoreDependencies": ["lefthook", "qrcode", "undici", "@types/react", "@cursor/sdk", "@anthropic-ai/claude-agent-sdk"],
      // System commands that tests run.
      "ignoreBinaries": ["mkfifo"]
    },
    "apps/desktop": {
      // Electron loads these by path; the shell has no package exports.
      "entry": ["src/main.cjs", "src/preload.cjs"]
    },
    "apps/host": {
      // Compiled into the application and selected by its native launcher.
      "entry": ["scripts/desktop-launch.ts"]
    },
    "apps/web": {
      // Static analysis only: running vite.config.ts as a dev-server config would read the default data directory. The
      // page's entry comes from index.html.
      "vite": { "config": [] },
      "entry": ["vite.config.ts"]
    },
    "e2e": {
      // Vitest reads the include pattern of e2e/vitest.config.ts from the working directory, the repository root; knip
      // reads it from the config's own directory and finds nothing, so the test files are entries here.
      "entry": ["*.e2e.ts"]
    },
    "packages/core": {},
    "packages/link-wire": {},
    "packages/link-client": {},
    "apps/relay": {},
    "packages/relay-core": {},
    "apps/relay-edge": {
      // The owner's own wrangler deploys these entries from deploy/; nothing in the repository imports them.
      "entry": ["src/worker.ts", "src/work.ts", "scripts/*.ts"]
    },
    "packages/harness-acp": {
      // Node runs the Cursor SDK runner by path (wires/cursor.ts), and its tests hand it the fake SDK by path.
      "entry": ["src/cursor-runner.ts", "test/fixtures/*.mjs"]
    },
    "packages/protocol": {},
    "packages/sdk": {},
    "packages/app-sdk": {},
    "packages/testkit": {},
    "packages/ui": {
      // The test-only gallery page: index.html loads this script; the visual capture builds and serves it.
      "entry": ["test/gallery/main.tsx"]
    }
  }
}
