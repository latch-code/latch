{
  "name": "harness-link",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Latch: a cross-device agent workspace that composes harnesses and model providers through Cordis plugins",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@11.22.0",
  "exports": {
    ".": "./dist/host/index.js",
    "./plugin-sdk": {
      "types": "./src/core/plugins.ts",
      "import": "./dist/core/plugins.js"
    },
    "./package.json": "./package.json",
    "./harness-sdk": {
      "types": "./src/core/harness.ts",
      "import": "./dist/core/harness.js"
    }
  },
  "scripts": {
    "build": "pnpm build:host && pnpm build:web && pnpm build:presence",
    "build:host": "tsx scripts/build.ts",
    "build:web": "vite build",
    "build:presence": "tsx scripts/build-presence.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "start": "tsx scripts/start.ts",
    "start:demo": "tsx scripts/start.ts --demo",
    "desktop": "tsx scripts/desktop.ts",
    "dev:web": "vite",
    "start:built": "node dist/start.js",
    "stop": "tsx scripts/stop.ts",
    "latch": "tsx scripts/latch.ts"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.12",
    "lucide-react": "1.61.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "7.30.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "electron": "44.7.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
