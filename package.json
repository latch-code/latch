{
  "name": "harness-link",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Latch: a cross-device agent workspace that composes harnesses and model providers through Cordis plugins",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024",
  "exports": {
    ".": "./dist/host/index.js",
    "./plugin-sdk": {
      "types": "./src/core/plugins.ts",
      "import": "./dist/core/plugins.js"
    },
    "./package.json": "./package.json",
    "./harness-sdk": {
      "types": "./src/core/harness.ts",
      "import": "./dist/core/harness.js"
    }
  },
  "scripts": {
    "build": "pnpm build:host && pnpm build:web && pnpm build:presence",
    "build:host": "tsx scripts/build.ts",
    "build:web": "vite build",
    "build:presence": "tsx scripts/build-presence.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check:supply": "tsx scripts/check-supply.ts",
    "start": "node --disable-sigusr1 --import tsx scripts/start.ts",
    "start:demo": "node --disable-sigusr1 --import tsx scripts/start.ts --demo",
    "desktop": "tsx scripts/desktop.ts",
    "dev:web": "vite",
    "start:built": "node --disable-sigusr1 dist/start.js",
    "stop": "tsx scripts/stop.ts",
    "latch": "tsx scripts/latch.ts"
  },
  "dependencies": {
    "cordis": "catalog:",
    "lucide-react": "catalog:",
    "qrcode": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:",
    "undici": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "electron": "catalog:",
    "esbuild": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
