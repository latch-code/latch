{
  "name": "latch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Latch: a cross-device agent workspace that composes harnesses and model providers through Cordis plugins",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024",
  "exports": {
    ".": "./dist/host/index.js",
    "./plugin-sdk": {
      "types": "./src/plugin-sdk.ts",
      "import": "./dist/core/plugins.js"
    },
    "./package.json": "./package.json",
    "./harness-sdk": {
      "types": "./src/harness-sdk.ts",
      "import": "./dist/core/harness.js"
    }
  },
  "scripts": {
    "build": "pnpm build:host && pnpm build:web && pnpm build:presence && pnpm build:relay",
    "build:host": "tsx apps/host/scripts/build.ts",
    "build:web": "vite build apps/web",
    "build:presence": "tsx apps/host/scripts/build-presence.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "check": "tsx scripts/check.ts",
    "check:quick": "tsx scripts/check.ts --quick",
    "check:supply": "tsx scripts/check-supply.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "check:agents": "tsx scripts/check-agents.ts",
    "agents:sync": "tsx scripts/agents-sync.ts",
    "docs:affected": "tsx scripts/docs-affected.ts",
    "security:scan": "tsx scripts/security-scan.ts",
    "knip": "knip && knip --strict --include unlisted,unresolved --no-config-hints",
    "check:workflows": "tsx scripts/check-workflows.ts",
    "start": "node --disable-sigusr1 --import tsx apps/host/scripts/start.ts",
    "start:demo": "node --disable-sigusr1 --import tsx apps/host/scripts/start.ts --demo",
    "desktop": "tsx apps/host/scripts/desktop.ts",
    "dev:web": "vite apps/web",
    "start:built": "node --disable-sigusr1 dist/start.js",
    "stop": "tsx apps/host/scripts/stop.ts",
    "latch": "node --disable-sigusr1 --import tsx apps/host/scripts/latch.ts",
    "build:relay": "tsx apps/relay/scripts/build.ts",
    "relay": "node --disable-sigusr1 --import tsx apps/relay/src/cli.ts",
    "build:relay-edge": "tsx apps/relay-edge/scripts/build.ts",
    "relay-edge:keygen": "node --disable-sigusr1 --import tsx apps/relay-edge/scripts/keygen.ts",
    "relay-edge:profile": "node --disable-sigusr1 --import tsx apps/relay-edge/scripts/profile.ts",
    "relay-edge:setup": "node --disable-sigusr1 --import tsx apps/relay-edge/scripts/setup.ts",
    "harness:record": "node --disable-sigusr1 --import tsx packages/harness-acp/test/record-harness.ts"
  },
  "dependencies": {
    "@latch/core": "workspace:*",
    "@latch/protocol": "workspace:*",
    "@latch/sdk": "workspace:*",
    "cordis": "catalog:",
    "qrcode": "catalog:",
    "undici": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@latch/host": "workspace:*",
    "@types/node": "catalog:",
    "@types/qrcode": "catalog:",
    "@types/react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "electron": "catalog:",
    "esbuild": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
