// Vitest and Playwright tests (tests/, e2e/ and each project's test/) and the test kit they import (packages/testkit):
// Node, plus DOM for code that runs in the page or renders components (the design system's tests run in a browser and
// import its stylesheets, which vite/client types). The test kit returns fetch Responses typed as
// the tests see them.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tests.tsbuildinfo"
  },
  "include": [
    "tests",
    "e2e",
    "apps/host/test",
    "apps/relay/test",
    "apps/relay-edge/test",
    "packages/link-wire/test",
    "packages/link-client/test",
    "apps/web/test",
    "apps/site/test",
    "apps/desktop/test",
    "packages/harness-acp/test",
    "packages/ui/test",
    "packages/app-sdk/test",
    "packages/testkit"
  ]
}
