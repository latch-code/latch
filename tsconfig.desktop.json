// Electron main process and preload (apps/desktop/src): CommonJS JavaScript checked against Node and Electron types, no
// DOM. noImplicitAny is off because plain JavaScript parameters carry no annotations; JSDoc types are added where
// inference needs them.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "Node20",
    "moduleResolution": "Node16",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/desktop.tsbuildinfo"
  },
  "include": ["apps/desktop/src"]
}
