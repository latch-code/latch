// A relay node on your own Cloudflare account: one Worker per regional node, so each can be drained and deployed on its
// own (a deploy resets every node object of the Worker it replaces). `pnpm relay-edge:setup` writes the config it
// deploys from these same values, outside the repository, and puts the secrets (RELAY_SIGNING_SEED, REGISTRATION_TOKEN,
// ADMIN_TOKEN) through its hardened wrangler runner; this file is the reviewed reference. No account id or secrets here.
{
  "name": "latch-relay",
  "main": "worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-11-01",

  // Reached at https://latch-relay-<env>.<子域>.workers.dev. Custom domains, if added later, are only further
  // addresses of the same node: clients bind a connection to the node by its relay-key signature, not by the name.
  "workers_dev": true,
  "preview_urls": false,

  // No Workers Logs, invocation logs, traces or Logpush. The code itself has no console output.
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false },
  },
  "logpush": false,

  // SQLite-backed node objects (DENY tags only).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayNode"] }],

  "env": {
    "ne": {
      "durable_objects": { "bindings": [{ "name": "NODE", "class_name": "RelayNode" }] },
      "services": [{ "binding": "WORK", "service": "latch-relay-work" }],
      // Optional custom domain, a zone on this account (then add its hostname to NODE_HOSTS):
      // "routes": [{ "pattern": "ne.relay.example.com", "custom_domain": true }],
      "vars": {
        "NODE_HOSTS": "latch-relay-ne.<子域>.workers.dev",
        "LOCATION_HINT": "apac-ne",
        "RELAY_ID": "<32 hex, generated by the setup>",
        "SHARDS": "1",
        "OBJECT_EPOCH": "1",
        // "false": only Hosts holding the relay file (REGISTRATION_TOKEN secret) may register.
        "OPEN_REGISTRATION": "false",
      },
    },
    "se": {
      "durable_objects": { "bindings": [{ "name": "NODE", "class_name": "RelayNode" }] },
      "services": [{ "binding": "WORK", "service": "latch-relay-work" }],
      // "routes": [{ "pattern": "se.relay.example.com", "custom_domain": true }],
      "vars": {
        "NODE_HOSTS": "latch-relay-se.<子域>.workers.dev",
        "LOCATION_HINT": "apac-se",
        "RELAY_ID": "<32 hex, generated by the setup>",
        "SHARDS": "1",
        "OBJECT_EPOCH": "1",
        // "false": only Hosts holding the relay file (REGISTRATION_TOKEN secret) may register.
        "OPEN_REGISTRATION": "false",
      },
    },
  },
}
