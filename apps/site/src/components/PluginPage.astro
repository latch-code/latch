---
// One plugin on its own page: what it adds, where it is used, what it can access and how to add it. Everything
// comes from the plugin's catalog entry and its own manifest (src/marketplace.ts).
import Base from '../layouts/Base.astro'
import GitHubLink from './GitHubLink.astro'
import MarketplaceCover from './MarketplaceCover.astro'
import { LINKS } from '../config'
import { COPY, href, type Lang } from '../i18n'
import { marketplaceDownloads, type Capability, type Tier } from '../marketplace'

interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props
const all = COPY[lang]
const t = all.marketplace
const d = t.detail
const downloads = await marketplaceDownloads()
const plugin = downloads.find((p) => p.entry.id === id)
if (!plugin) throw new Error(`No plugin "${id}" in the catalog`)
const { entry, name, version, href: bundle, facets: provides, access } = plugin
const copy = entry[lang]
const others = downloads.filter((p) => p.entry.id !== id).slice(0, 3)
const list = href(lang, '/plugins/')
const dl = href(lang, '/download/')
const source = `${LINKS.github}/tree/main/examples/${entry.folder}`
// Search descriptions must stay inside the length the SEO check allows; the longer tail is dropped when it would not fit.
const limit = lang === 'zh' ? 90 : 160
const description = [...`${copy.summary} ${d.metaTail}`].length <= limit ? `${copy.summary} ${d.metaTail}` : `${copy.summary} ${d.metaShort}`
const capability = (c: Capability) => {
  switch (c.kind) {
    case 'start':
      return c.projects === 'any' ? t.caps.startAny : t.caps.startSome.replace('{n}', String(c.projects))
    case 'storage':
      return t.caps.storage.replace('{scopes}', c.scopes.map((s) => t.caps.scopes[s as keyof typeof t.caps.scopes] ?? s).join(t.caps.join))
    default:
      return t.caps[c.kind]
  }
}
const download = '<svg class="i" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5v7.5M4.75 7 8 10.25 11.25 7M3 13.25h10"/></svg>'
const back = '<svg class="i" viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4"/></svg>'
const check = '<svg class="i" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5 6.5 11.5 12.5 4.5"/></svg>'
const shield = '<svg class="i" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.75 2.75 3.75v4c0 3.1 2.2 5.4 5.25 6.5 3.05-1.1 5.25-3.4 5.25-6.5v-4z"/><path d="M5.75 8 7.25 9.5 10.25 6.5"/></svg>'
const TIER_ICONS: Record<Tier, string> = {
  text: '<path d="M9.25 1.75H4.5A1.75 1.75 0 0 0 2.75 3.5v9a1.75 1.75 0 0 0 1.75 1.75h7a1.75 1.75 0 0 0 1.75-1.75V5.75z"/><path d="M5.75 8h4.5M5.75 11h3"/>',
  host: '<rect x="1.75" y="2.75" width="12.5" height="10.5" rx="1.75"/><path d="M4.75 6.25 6.75 8l-2 1.75M8.25 10h3"/>',
  panel: '<rect x="1.75" y="2.75" width="12.5" height="10.5" rx="1.75"/><path d="M9.75 2.75v10.5"/>',
  page: '<rect x="1.75" y="2.75" width="12.5" height="10.5" rx="1.75"/><rect x="4.5" y="5.5" width="7" height="5" rx="1"/>',
}
---
<Base lang={lang} path={`/plugins/${id}/`} title={d.metaTitle.replace('{name}', copy.name)} description={description}>
  <article class="pp" aria-labelledby="pp-title">
    <div class="wrap">
      <a class="pp__back" href={list}><Fragment set:html={back} /><span>{d.back}</span></a>
      <header class="pp__head">
        <div class="pp__intro">
          <h1 id="pp-title" class="pp__title">{copy.name}</h1>
          <p class="pp__summary">{copy.summary}</p>
          <ul class="pp__chips">
            {provides.map((f) => <li>{t.facets[f]}</li>)}
            <li class="pp__v">v{version}</li>
          </ul>
        </div>
        <div class="pp__actions">
          <a class="btn btn--panel" href={bundle} download={name + '.latch-plugin.json'}><Fragment set:html={download} /><span>{t.download}</span></a>
          <a class="btn btn--quiet" href={`${dl}#mac`}><span>{d.getLatch}</span></a>
          <GitHubLink class="btn btn--quiet" href={source} label={d.viewSource} soon={all.cta.soon} />
        </div>
      </header>

      <div class="pp__grid">
        <div class="pp__main">
          <div class="pp__cover"><MarketplaceCover id={entry.id} lang={lang} /></div>

          <section aria-labelledby="pp-adds">
            <h2 id="pp-adds">{d.adds}</h2>
            <dl class="pp__rows">
              <div><dt>{d.kind}</dt><dd>{copy.kind}</dd></div>
              <div><dt>{t.agent}</dt><dd>{copy.agent}</dd></div>
              <div><dt>{t.use}</dt><dd>{copy.use}</dd></div>
            </dl>
          </section>

          <section aria-labelledby="pp-access">
            <h2 id="pp-access">{t.access}</h2>
            <div class="pp__access" data-tier={access.tier}>
              <p class="pp__tier"><svg class="i" viewBox="0 0 16 16" aria-hidden="true" set:html={TIER_ICONS[access.tier]} /><strong>{t.tiers[access.tier].name}</strong></p>
              <p class="pp__note">{t.tiers[access.tier].note}</p>
              {access.capabilities.length > 0 && (
                <ul class="pp__caps">{access.capabilities.map((c) => <li><Fragment set:html={check} />{capability(c)}</li>)}</ul>
              )}
              <p class="pp__text">{copy.access}</p>
              {access.confirm && <p class="pp__confirm"><Fragment set:html={shield} />{t.confirm}</p>}
            </div>
          </section>

          <section aria-labelledby="pp-install">
            <h2 id="pp-install">{d.install}</h2>
            <ol class="pp__steps">
              {d.steps.map((step) => <li>{step.replace('{name}', copy.name)}</li>)}
            </ol>
            <p class="pp__alt">{d.byFile}</p>
          </section>
        </div>

        <aside class="pp__side" aria-label={d.facts}>
          <dl class="pp__meta">
            <div><dt>{d.publisher}</dt><dd>Latch</dd></div>
            <div><dt>{t.version}</dt><dd>{version}</dd></div>
            <div><dt>{t.access}</dt><dd>{t.tiers[access.tier].name}</dd></div>
            <div><dt>{d.provides}</dt><dd>{provides.map((f) => t.facets[f]).join(t.caps.join)}</dd></div>
            <div><dt>{d.catalog}</dt><dd>{d.bundled}</dd></div>
          </dl>
          <p class="pp__idlabel">{d.pluginId}</p>
          <p class="pp__id"><code>{entry.id}</code></p>
          <p class="pp__links"><a href={source} rel="noopener">{d.viewSource}</a></p>
        </aside>
      </div>

      {others.length > 0 && (
        <section class="pp__more" aria-labelledby="pp-more">
          <h2 id="pp-more">{d.more}</h2>
          <ul class="pp__others">
            {others.map((o) => (
              <li>
                <a href={href(lang, `/plugins/${o.entry.id}/`)}>
                  <strong>{o.entry[lang].name}</strong>
                  <span class="pp__okind">{o.facets.map((f) => t.facets[f]).join(t.caps.join)}</span>
                  <span class="pp__osum">{o.entry[lang].summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>
</Base>
<style>
  .pp { padding-block: calc(var(--nav-height) + var(--space-2xl)) var(--section-gap-s); }
  .pp__back { display: inline-flex; align-items: center; gap: var(--space-xs); min-height: 44px; color: var(--color-muted); font-size: var(--text-sm); text-decoration: none; border-radius: var(--radius-chip); }
  .pp__back:hover { color: var(--color-ink); }
  .pp__back:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .pp__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-lg) var(--space-2xl); margin-top: var(--space-md); }
  .pp__intro { display: grid; gap: var(--space-sm); min-width: 0; }
  .pp__title { font-size: var(--text-section); line-height: 1.08; letter-spacing: var(--tracking-section); max-width: none; }
  html:lang(zh-CN) .pp__title { line-height: 1.2; }
  .pp__summary { color: var(--color-muted); font-size: var(--text-lead); max-width: 34em; }
  .pp__chips { list-style: none; margin: var(--space-2xs) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2xs); }
  .pp__chips li {
    display: inline-flex; align-items: center; min-height: 24px; padding: 0 var(--space-xs);
    border-radius: var(--radius-chip); box-shadow: inset 0 0 0 1px var(--color-rule-strong); color: var(--color-ink-2);
    font-size: var(--text-xs); font-weight: 500; white-space: nowrap;
  }
  .pp__v { font-variant-numeric: tabular-nums; }
  .pp__actions { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .pp__grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: var(--space-xl); align-items: start; margin-top: var(--space-xl); }
  .pp__main { display: grid; gap: var(--space-2xl); min-width: 0; }
  .pp__cover { overflow: hidden; border-radius: 20px; box-shadow: 0 0 0 1px var(--color-rule-strong); container-type: inline-size; }
  .pp__cover :global(.market-feature) { aspect-ratio: 16 / 9; min-block-size: 0; }
  .pp__cover :global(.market-pattern-cover) { aspect-ratio: 16 / 9; }
  @container (min-width: 500px) { :global(.market-feature-content) { zoom: 1.6; } }
  @container (min-width: 760px) { :global(.market-feature-content) { zoom: 2.1; } }
  .pp h2 { font-size: var(--text-xl); letter-spacing: -0.02em; line-height: 1.2; max-width: none; }
  .pp__rows, .pp__access, .pp__side { border-radius: var(--radius-card); background: var(--color-paper-2); box-shadow: 0 0 0 1px var(--color-rule); }
  .pp__rows { margin: var(--space-md) 0 0; }
  .pp__rows div { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr); gap: var(--space-md); padding: var(--space-md) var(--space-lg); }
  .pp__rows div + div { border-top: 1px solid var(--color-rule); }
  .pp__rows dt { color: var(--color-muted); font-size: var(--text-sm); }
  .pp__rows dd { margin: 0; color: var(--color-ink); }
  .pp__access { display: grid; gap: var(--space-xs); margin-top: var(--space-md); padding: var(--space-lg); }
  .pp__tier { display: flex; align-items: center; gap: var(--space-xs); font-size: var(--text-lg); }
  .pp__tier .i { width: 18px; height: 18px; color: var(--color-ink-2); }
  .pp__access[data-tier='host'] .pp__tier .i,
  .pp__access[data-tier='panel'] .pp__tier .i { color: var(--color-wait); }
  .pp__note { color: var(--color-ink-2); }
  .pp__caps { list-style: none; margin: var(--space-2xs) 0; padding: 0; display: grid; gap: var(--space-2xs); }
  .pp__caps li, .pp__confirm { display: flex; gap: var(--space-xs); align-items: baseline; font-size: var(--text-sm); }
  .pp__caps :global(.i), .pp__confirm :global(.i) { flex: none; width: 14px; height: 14px; transform: translateY(2px); color: var(--color-ink-2); }
  .pp__text { color: var(--color-muted); font-size: var(--text-sm); line-height: 1.55; padding-top: var(--space-sm); border-top: 1px solid var(--color-rule); }
  .pp__confirm { color: var(--color-ink-2); }
  .pp__steps { margin: var(--space-md) 0 0; padding-left: 1.25em; display: grid; gap: var(--space-xs); color: var(--color-ink-2); }
  .pp__alt { margin-top: var(--space-md); color: var(--color-muted); font-size: var(--text-sm); }
  .pp__side { position: sticky; top: calc(var(--nav-height) + var(--space-lg)); padding: var(--space-xs) var(--space-lg) var(--space-lg); font-size: var(--text-sm); }
  .pp__meta { margin: 0; }
  .pp__meta div { display: flex; justify-content: space-between; gap: var(--space-md); padding: var(--space-sm) 0; border-bottom: 1px solid var(--color-rule); }
  .pp__meta dt { color: var(--color-muted); }
  .pp__meta dd { margin: 0; color: var(--color-ink); text-align: right; font-variant-numeric: tabular-nums; }
  .pp__idlabel { margin-top: var(--space-md); color: var(--color-muted); }
  .pp__id { margin-top: var(--space-2xs); padding: var(--space-xs) var(--space-sm); border-radius: var(--radius-control); background: var(--color-paper-3); overflow-wrap: anywhere; }
  .pp__id code { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-ink-2); }
  .pp__links { margin-top: var(--space-md); }
  .pp__links a, .pp__others a { color: var(--color-ink-2); text-decoration-color: var(--color-rule-strong); }
  .pp__links a:hover { color: var(--color-ink); text-decoration-color: currentColor; }
  .pp__more { margin-top: var(--space-3xl); }
  .pp__others { list-style: none; margin: var(--space-md) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--space-md); }
  .pp__others a {
    display: grid; gap: var(--space-2xs); height: 100%; padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-card); background: var(--color-paper-2); box-shadow: 0 0 0 1px var(--color-rule); text-decoration: none;
    transition: box-shadow var(--dur-short) var(--ease-out);
  }
  .pp__others a:hover { box-shadow: 0 0 0 1px var(--color-rule-strong); }
  .pp__others a:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .pp__others strong { color: var(--color-ink); font-weight: 600; }
  .pp__okind { color: var(--color-faint); font-size: var(--text-xs); }
  .pp__osum { color: var(--color-muted); font-size: var(--text-sm); }
  @media (max-width: 64rem) {
    .pp__grid { grid-template-columns: minmax(0, 1fr); }
    .pp__side { position: static; }
  }
  @media (max-width: 40rem) {
    .pp__rows div { grid-template-columns: minmax(0, 1fr); gap: var(--space-2xs); padding: var(--space-md); }
    .pp__access { padding: var(--space-md); }
    .pp__actions, .pp__actions :global(.btn) { width: 100%; }
  }
</style>
