---
import Base from '../layouts/Base.astro'
import Film from './Film.astro'
import GitHubLink from './GitHubLink.astro'
import MarketplaceCover from './MarketplaceCover.astro'
import { LINKS } from '../config'
import { COPY, href, type Lang } from '../i18n'
import { FACETS, marketplaceDownloads, type Capability, type Tier } from '../marketplace'

interface Props { lang: Lang }
const { lang } = Astro.props
const all = COPY[lang]
const t = all.marketplace
const downloads = await marketplaceDownloads()
const dl = href(lang, '/download/')
// Only the kinds some plugin actually provides get a filter.
const facets = FACETS.filter((f) => downloads.some((d) => d.facets.includes(f)))
const capability = (c: Capability) => {
  switch (c.kind) {
    case 'start':
      return c.projects === 'any' ? t.caps.startAny : t.caps.startSome.replace('{n}', String(c.projects))
    case 'storage':
      return t.caps.storage.replace('{scopes}', c.scopes.map((s) => t.caps.scopes[s as keyof typeof t.caps.scopes] ?? s).join(t.caps.join))
    default:
      return t.caps[c.kind]
  }
}
const download = '<svg class="i" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5v7.5M4.75 7 8 10.25 11.25 7M3 13.25h10"/></svg>'
// Line icons on the app's 16px grid, one per kind of access.
const TIER_ICONS: Record<Tier, string> = {
  text: '<path d="M9.25 1.75H4.5A1.75 1.75 0 0 0 2.75 3.5v9a1.75 1.75 0 0 0 1.75 1.75h7a1.75 1.75 0 0 0 1.75-1.75V5.75z"/><path d="M5.75 8h4.5M5.75 11h3"/>',
  host: '<rect x="1.75" y="2.75" width="12.5" height="10.5" rx="1.75"/><path d="M4.75 6.25 6.75 8l-2 1.75M8.25 10h3"/>',
  panel: '<rect x="1.75" y="2.75" width="12.5" height="10.5" rx="1.75"/><path d="M9.75 2.75v10.5"/>',
  page: '<rect x="1.75" y="2.75" width="12.5" height="10.5" rx="1.75"/><rect x="4.5" y="5.5" width="7" height="5" rx="1"/>',
}
const check = '<svg class="i" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5 6.5 11.5 12.5 4.5"/></svg>'
const shield = '<svg class="i" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.75 2.75 3.75v4c0 3.1 2.2 5.4 5.25 6.5 3.05-1.1 5.25-3.4 5.25-6.5v-4z"/><path d="M5.75 8 7.25 9.5 10.25 6.5"/></svg>'
const WAY_ICONS = [
  '<rect x="1.75" y="1.75" width="5.25" height="5.25" rx="1.25"/><rect x="9" y="1.75" width="5.25" height="5.25" rx="1.25"/><rect x="1.75" y="9" width="5.25" height="5.25" rx="1.25"/><rect x="9" y="9" width="5.25" height="5.25" rx="1.25"/>',
  '<path d="M6.5 9.5 9.5 6.5"/><path d="M7.25 4.25 8.5 3a2.83 2.83 0 0 1 4 4l-1.25 1.25M8.75 11.75 7.5 13a2.83 2.83 0 0 1-4-4l1.25-1.25"/>',
  '<path d="M9.25 1.75H4.5A1.75 1.75 0 0 0 2.75 3.5v9a1.75 1.75 0 0 0 1.75 1.75h7a1.75 1.75 0 0 0 1.75-1.75V5.75z"/><path d="M8 6.5v5M5.75 9.25 8 11.5l2.25-2.25"/>',
]
---
<Base lang={lang} path="/plugins/" title={t.metaTitle} description={t.metaDescription}>
  <section class="hero market" aria-labelledby="market-title">
    <div class="wrap hero__head">
      <h1 id="market-title" class="hero__title">{t.title1} <span class="hero__joint">{t.title2}</span></h1>
      <p class="lead">{t.lede}</p>
      <div class="actions">
        <a class="btn btn--panel" href={`${dl}#mac`}><Fragment set:html={download} /><span>{all.cta.mac}</span></a>
        <GitHubLink class="btn btn--quiet" href={LINKS.pluginPublish} label={t.publish} soon={all.cta.soon} />
      </div>
    </div>

    <div class="wrap gallery">
      <h2 class="visually-hidden" id="gallery-title">{t.galleryTitle}</h2>
      <ul class="gallery__list" aria-labelledby="gallery-title">
        {downloads.map(({ entry, version, facets: provides }) => (
          <li class="card">
            <div class="card__cover"><MarketplaceCover id={entry.id} lang={lang} /></div>
            <div class="card__body">
              <h3 class="card__name"><a class="card__link" href={`#${entry.id}`}>{entry[lang].name}</a></h3>
              <p class="card__summary">{entry[lang].summary}</p>
              <div class="card__foot">
                <ul class="chips">{provides.map((f) => <li>{t.facets[f]}</li>)}</ul>
                <span class="card__version">v{version}</span>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band plugins" aria-labelledby="details-title">
    <div class="wrap">
      <h2 id="details-title" class="features__title">{t.detailsTitle}</h2>
      {facets.map((f) => <span class="facet-target" id={`provides-${f}`}></span>)}
      <div class="filter" data-filter data-one={t.countOne} data-many={t.countMany}>
        <div class="pills" role="group" aria-label={t.filterLabel}>
          <a class="tab" href="#details-title" data-facet="all">{t.facets.all}</a>
          {facets.map((f) => <a class="tab" href={`#provides-${f}`} data-facet={f}>{t.facets[f]}</a>)}
        </div>
        <p class="visually-hidden" role="status" data-filter-status></p>
      </div>

      <div class="details">
        {downloads.map(({ entry, name, version, href: bundle, facets: provides, access }) => (
          <article id={entry.id} class="plugin" data-facets={provides.join(' ')}>
            <div class="plugin__side">
              <div class="plugin__cover"><MarketplaceCover id={entry.id} lang={lang} /></div>
              <dl class="plugin__meta">
                <div><dt>{t.version}</dt><dd>{version}</dd></div>
                <div><dt>{t.source}</dt><dd><a href={`${LINKS.github}/tree/main/examples/${entry.folder}`} rel="noopener">examples/{entry.folder}</a></dd></div>
              </dl>
              <a class="btn btn--quiet plugin__download" href={bundle} download={name + '.latch-plugin.json'} aria-label={`${t.download} · ${entry[lang].name}`}>
                <Fragment set:html={download} /><span>{t.download}</span>
              </a>
            </div>
            <div class="plugin__main">
              <ul class="chips">{provides.map((f) => <li>{t.facets[f]}</li>)}</ul>
              <h3 class="plugin__name">{entry[lang].name}</h3>
              <p class="plugin__summary">{entry[lang].summary}</p>
              <div class="access" data-tier={access.tier}>
                <p class="access__label">{t.access}</p>
                <p class="access__tier">
                  <svg class="i" viewBox="0 0 16 16" aria-hidden="true" set:html={TIER_ICONS[access.tier]} />
                  <strong>{t.tiers[access.tier].name}</strong>
                </p>
                <p class="access__note">{t.tiers[access.tier].note}</p>
                {access.capabilities.length > 0 && (
                  <ul class="access__caps">{access.capabilities.map((c) => <li><Fragment set:html={check} />{capability(c)}</li>)}</ul>
                )}
                <p class="access__text">{entry[lang].access}</p>
                {access.confirm && <p class="access__confirm"><Fragment set:html={shield} />{t.confirm}</p>}
              </div>
              <dl class="plugin__facts">
                <dt>{t.use}</dt><dd>{entry[lang].use}</dd>
                <dt>{t.agent}</dt><dd>{entry[lang].agent}</dd>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band ways" aria-labelledby="ways-title">
    <div class="wrap">
      <h2 id="ways-title" class="section-title">{t.ways.title}</h2>
      <ol class="ways__list">
        {t.ways.items.map((w, i) => (
          <li>
            <span class="ways__icon"><svg class="i" viewBox="0 0 16 16" aria-hidden="true" set:html={WAY_ICONS[i]} /></span>
            <h3>{w.title}</h3>
            <p>{w.body}</p>
          </li>
        ))}
      </ol>
      <p class="ways__note"><Fragment set:html={shield} /><span>{t.ways.note}</span></p>
    </div>
  </section>

  <section class="band create" aria-labelledby="create-title">
    <div class="wrap">
      <div class="create__tile">
        <div class="create__head">
          <h2 id="create-title" class="section-title">{t.create.title}</h2>
          <p class="body">{t.create.body}</p>
          <p class="create__note">{t.create.note}</p>
        </div>
        <ol class="create__steps">
          {t.create.steps.map((s, i) => (
            <li><span class="create__n">{i + 1}</span><span class="create__step"><strong>{s.title}</strong><span>{s.body}</span></span></li>
          ))}
        </ol>
        <Film id="plugin-create" lang={lang} class="create__film" />
      </div>
    </div>
  </section>

  <section class="band trust market-trust" aria-labelledby="trust-title">
    <div class="wrap market-trust__inner">
      <div class="trust__text">
        <h2 id="trust-title">{t.trust.title}</h2>
        <p class="body">{t.trust.body}</p>
      </div>
      <ul class="keeps">
        <li><strong>{t.trust.k1t}</strong> <span>{t.trust.k1}</span></li>
        <li><strong>{t.trust.k2t}</strong> <span>{t.trust.k2}</span></li>
        <li><strong>{t.trust.k3t}</strong> <span>{t.trust.k3}</span></li>
      </ul>
    </div>
    <div class="wrap">
      <p class="dev">
        {t.dev.lead} <a href="/plugins/latch.catalog.json" type="application/json">{t.dev.catalog}</a><span aria-hidden="true"> · </span><a href={LINKS.pluginGuide} rel="noopener">{t.dev.guide}</a>
      </p>
    </div>
  </section>
</Base>
<style>
  /* Hero: the home page's idiom, then the four plugins Latch ships, large, with their live covers. */
  .market { padding-bottom: 0; }
  .gallery { margin-top: var(--space-3xl); }
  .gallery__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
  }
  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-radius: 20px;
    background: var(--color-paper-2);
    box-shadow: 0 0 0 1px var(--color-rule);
    transition: box-shadow var(--dur-short) var(--ease-out), transform var(--dur-short) var(--ease-out);
  }
  .card:hover { box-shadow: 0 0 0 1px var(--color-rule-strong), 0 40px 80px -50px var(--color-shot-shadow); }
  .card:has(.card__link:focus-visible) { outline: 2px solid var(--color-focus); outline-offset: 3px; }
  .card__cover, .plugin__cover { container-type: inline-size; }
  .card__cover :global(.market-feature), .plugin__cover :global(.market-feature) { aspect-ratio: 16 / 9; min-block-size: 0; }
  .card__cover :global(.market-pattern-cover), .plugin__cover :global(.market-pattern-cover) { aspect-ratio: 16 / 9; }
  @container (min-width: 380px) { :global(.market-feature-content) { zoom: 1.3; } }
  @container (min-width: 500px) { :global(.market-feature-content) { zoom: 1.6; } }
  .card__body { display: flex; flex-direction: column; gap: var(--space-xs); padding: var(--space-lg); border-top: 1px solid var(--color-rule); }
  .card__name { font-size: var(--text-xl); letter-spacing: -0.02em; line-height: 1.2; max-width: none; }
  .card__link { text-decoration: none; color: inherit; }
  .card__link:focus-visible { outline: none; }
  .card__link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .card__summary { color: var(--color-muted); max-width: 36em; }
  .card__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); margin-top: auto; padding-top: var(--space-xs); }
  .card__version, .chips li { font-variant-numeric: tabular-nums; }
  .card__version { color: var(--color-faint); font-size: var(--text-sm); }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2xs); }
  .chips li {
    display: inline-flex; align-items: center; min-height: 24px; padding: 0 var(--space-xs);
    border-radius: var(--radius-chip); background: var(--color-paper-3); color: var(--color-ink-2);
    font-size: var(--text-xs); font-weight: 500; white-space: nowrap;
  }

  /* Every plugin in detail, filtered by what it provides. Without scripting the pills are links and :target filters. */
  .facet-target { display: block; position: relative; top: calc(-1 * var(--space-xl)); }
  .filter { display: grid; justify-items: center; margin-top: var(--space-xl); }
  html:not(.js) .facet-target:target ~ .filter .tab[data-facet='all'] { color: var(--color-muted); background: transparent; }
  html:not(.js) .filter .tab[data-facet='all'],
  html:not(.js) #provides-skill:target ~ .filter .tab[data-facet='skill'],
  html:not(.js) #provides-panel:target ~ .filter .tab[data-facet='panel'],
  html:not(.js) #provides-app:target ~ .filter .tab[data-facet='app'],
  html:not(.js) #provides-tool:target ~ .filter .tab[data-facet='tool'] { color: var(--color-on-panel); background: var(--color-panel); }
  html:not(.js) #provides-skill:target ~ .details .plugin:not([data-facets~='skill']),
  html:not(.js) #provides-panel:target ~ .details .plugin:not([data-facets~='panel']),
  html:not(.js) #provides-app:target ~ .details .plugin:not([data-facets~='app']),
  html:not(.js) #provides-tool:target ~ .details .plugin:not([data-facets~='tool']) { display: none; }
  .details { margin-top: var(--space-xl); border-bottom: 1px solid var(--color-rule); }
  .plugin[hidden] { display: none; }
  .plugin {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-2xl);
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--color-rule);
    scroll-margin-top: calc(var(--nav-height) + var(--space-md));
  }
  .plugin:target .plugin__cover { box-shadow: 0 0 0 1px var(--color-ink-2); }
  .plugin__side { display: grid; gap: var(--space-md); align-content: start; position: sticky; top: calc(var(--nav-height) + var(--space-lg)); align-self: start; }
  .plugin__cover { overflow: hidden; border-radius: var(--radius-card); box-shadow: 0 0 0 1px var(--color-rule-strong); transition: box-shadow var(--dur-long) var(--ease-out); }
  .plugin__meta { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-2xs) var(--space-lg); margin: 0; font-size: var(--text-sm); }
  .plugin__meta div { display: contents; }
  .plugin__meta dt { color: var(--color-faint); }
  .plugin__meta dd { margin: 0; color: var(--color-ink-2); font-variant-numeric: tabular-nums; min-width: 0; overflow-wrap: anywhere; }
  .plugin__meta a { color: inherit; text-decoration-color: var(--color-rule-strong); }
  .plugin__meta a:hover { text-decoration-color: currentColor; }
  .plugin__download { justify-self: start; }
  .plugin__main { display: grid; gap: var(--space-md); align-content: start; }
  .plugin__name { font-size: var(--text-2xl); letter-spacing: -0.025em; line-height: 1.12; }
  .plugin__summary { color: var(--color-ink-2); font-size: var(--text-lead); line-height: 1.5; max-width: 34em; }

  /* What it can access: the plugin's trust in one block, scannable before the prose. */
  .access {
    display: grid;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
    padding: var(--space-lg);
    border-radius: var(--radius-card);
    background: var(--color-paper-2);
    box-shadow: 0 0 0 1px var(--color-rule);
  }
  .access__label { color: var(--color-faint); font-size: var(--text-sm); }
  .access__tier { display: flex; align-items: center; gap: var(--space-xs); font-size: var(--text-lg); }
  .access__tier .i { width: 20px; height: 20px; color: var(--color-ink-2); }
  .access__tier strong { font-weight: 600; letter-spacing: -0.01em; }
  .access[data-tier='host'] .access__tier .i,
  .access[data-tier='panel'] .access__tier .i { color: var(--color-wait); }
  .access__note { color: var(--color-ink-2); }
  .access__caps { list-style: none; margin: var(--space-2xs) 0; padding: 0; display: grid; gap: var(--space-2xs); }
  .access__caps li { display: flex; gap: var(--space-xs); align-items: baseline; color: var(--color-ink); font-size: var(--text-sm); }
  .access__caps .i { flex: none; width: 14px; height: 14px; transform: translateY(2px); color: var(--color-ink-2); }
  .access__text { color: var(--color-muted); font-size: var(--text-sm); line-height: 1.55; padding-top: var(--space-xs); border-top: 1px solid var(--color-rule); }
  .access__confirm { display: flex; gap: var(--space-xs); align-items: baseline; color: var(--color-ink-2); font-size: var(--text-sm); }
  .access__confirm .i { flex: none; width: 14px; height: 14px; transform: translateY(2px); }
  .plugin__facts { margin: var(--space-xs) 0 0; display: grid; gap: var(--space-2xs); }
  .plugin__facts dt { font-weight: 600; color: var(--color-ink); margin-top: var(--space-sm); }
  .plugin__facts dt:first-child { margin-top: 0; }
  .plugin__facts dd { margin: 0; color: var(--color-muted); max-width: 40em; }

  /* Three ways in, then making one. */
  .section-title {
    font-size: var(--text-section);
    line-height: 1.06;
    letter-spacing: var(--tracking-section);
    max-width: 16em;
  }
  html:lang(zh-CN) .section-title { line-height: 1.2; }
  .ways__list {
    list-style: none;
    margin: var(--space-2xl) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
  }
  .ways__list li {
    display: grid; gap: var(--space-sm); align-content: start;
    padding: var(--space-xl) var(--space-lg) var(--space-lg);
    border-radius: 20px; background: var(--color-paper-2); box-shadow: 0 0 0 1px var(--color-rule);
  }
  .ways__icon {
    display: grid; place-items: center; width: 40px; height: 40px; margin-bottom: var(--space-xs);
    border-radius: var(--radius-control); background: var(--color-paper-3); color: var(--color-ink);
  }
  .ways__icon .i { width: 18px; height: 18px; }
  .ways__list h3 { font-size: var(--text-title); letter-spacing: -0.015em; }
  .ways__list p { color: var(--color-muted); }
  .ways__note { display: flex; gap: var(--space-sm); align-items: baseline; margin-top: var(--space-xl); color: var(--color-ink-2); max-width: 52em; }
  .ways__note :global(.i) { flex: none; transform: translateY(3px); color: var(--color-ink-2); }
  .create__tile {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-2xl);
    padding: var(--space-2xl);
    border-radius: 22px;
    background: var(--color-paper-2);
    box-shadow: 0 0 0 1px var(--color-rule), 0 40px 90px -60px var(--color-shot-shadow);
  }
  .create__head { display: grid; gap: var(--space-md); align-content: start; }
  .create__steps { list-style: none; margin: 0; padding: 0; display: grid; }
  .create__steps li { position: relative; display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: var(--space-md); padding-bottom: var(--space-lg); }
  .create__steps li:last-child { padding-bottom: 0; }
  .create__steps li:not(:last-child)::before { content: ''; position: absolute; left: 15.5px; top: 36px; bottom: 4px; width: 1px; background: var(--color-rule-strong); }
  .create__n {
    display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--color-rule-strong); color: var(--color-ink-2);
    font: 500 var(--text-sm)/1 var(--font-body); font-variant-numeric: tabular-nums;
  }
  .create__steps li:first-child .create__n { background: var(--color-panel); box-shadow: none; color: var(--color-on-panel); }
  .create__step { display: grid; gap: var(--space-2xs); padding-top: 4px; color: var(--color-muted); }
  .create__step strong { color: var(--color-ink); font-size: var(--text-title); font-weight: 600; letter-spacing: -0.015em; line-height: 1.3; }
  .create__tile :global(.create__film) { grid-column: 1 / -1; }
  .create__note { color: var(--color-faint); font-size: var(--text-sm); margin-top: auto; }

  /* Trust, in the home page's terms. */
  .market-trust__inner { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-2xl); align-items: start; }
  .market-trust .keeps { margin-top: 0; }
  .market-trust { padding-bottom: var(--section-gap-s); }
  .dev { margin-top: var(--space-2xl); color: var(--color-faint); font-size: var(--text-sm); }
  .dev a { color: var(--color-ink-2); text-decoration-color: var(--color-rule-strong); }
  .dev a:hover { color: var(--color-ink); text-decoration-color: currentColor; }

  @media (max-width: 64rem) {
    .plugin { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
    .plugin__side { position: static; }
    .market-trust__inner { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
    .ways__list { grid-template-columns: minmax(0, 1fr); gap: var(--space-md); }
    .create__tile { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); padding: var(--space-xl); }
  }
  @media (max-width: 40rem) {
    .gallery__list { grid-template-columns: minmax(0, 1fr); gap: var(--space-md); }
    .gallery { margin-top: var(--space-2xl); }
    .card__body { padding: var(--space-md); }
    .card__name { font-size: var(--text-lg); }
    .plugin { padding-block: var(--space-xl); }
    .plugin__name { font-size: var(--text-xl); }
    .plugin__download { justify-self: stretch; }
    .access { padding: var(--space-md); }
    .create__tile { padding: var(--space-lg); }
    .plugin__main { order: -1; }
    .plugin__cover { display: none; }
    .filter .pills { justify-self: stretch; }
  }
</style>
