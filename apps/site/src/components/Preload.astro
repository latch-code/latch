---
// Preloads the film's first frame on the Mac, the largest paint, so it never waits for layout.
import PICS from '../pics.json'
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const p = PICS['hero-mac-first']
const set = p.widths.map((w) => `${base}img/${p.file}-${w}.avif ${w}w`).join(', ')
const sizes = '(min-width: 1464px) 1148px, (min-width: 832px) 70vw, 92vw'
---
<link rel="preload" as="image" type="image/avif" imagesrcset={set} imagesizes={sizes} fetchpriority="high" />
