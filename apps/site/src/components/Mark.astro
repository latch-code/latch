---
// An agent's brand icon, as the app draws it in dark mode (apps/web/src/brands.ts): the brand's dark-theme file
// where it has one, its own file otherwise, a currentColor mask for one-colour marks, or a neutral glyph.
import type { Agent } from '../i18n'

interface Props { agent?: Agent; glyph?: boolean }
const { agent, glyph = false } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const cls = agent ? ['mark', { 'mark--margin': agent.margin, 'mark--tile': agent.tile }] : ['mark']
---
{glyph ? (
  <span class="mark mark--glyph" aria-hidden="true"><svg class="i" viewBox="0 0 16 16"><path d="M5.25 4.5 2.5 8l2.75 3.5M10.75 4.5 13.5 8l-2.75 3.5M7 10.5h2" /></svg></span>
) : agent?.mono ? (
  <span class={`mark mark--mono mark--${agent.id}`} aria-hidden="true"><span></span></span>
) : (
  <span class:list={cls} aria-hidden="true"><img src={`${base}brands/${agent?.dark ?? agent?.src}`} alt="" width="18" height="18" loading="lazy" decoding="async" /></span>
)}
