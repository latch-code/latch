// Browser client and the isomorphic shared code: DOM, no Node globals. Some dependency typings still
// reference Node's types, so `.oxlintrc.json` also flags Node globals and modules here.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "tsBuildInfoFile": "./node_modules/.cache/typescript/web.tsbuildinfo"
  },
  "include": ["src/client", "src/shared"]
}
