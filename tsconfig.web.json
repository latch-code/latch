// Browser client (apps/web/src), its design system (packages/ui/src) and the plugin page SDK (packages/app-sdk/src): DOM, no Node globals. Some dependency typings still reference Node's types, so
// `.oxlintrc.json` also flags Node globals and modules here.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "tsBuildInfoFile": "./node_modules/.cache/typescript/web.tsbuildinfo"
  },
  "include": ["apps/web/src", "packages/ui/src", "packages/app-sdk/src"]
}
