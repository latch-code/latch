// Node ESM without the DOM: the Host (apps/host), the ACP driver (packages/harness-acp), the repository's scripts and
// tool configs, the web client's Vite config among them.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.cache/typescript/host.tsbuildinfo"
  },
  "include": [
    "apps/host/src",
    "apps/relay/src",
    "apps/relay/scripts",
    "apps/relay-edge/scripts",
    "packages/link-client/src",
    "apps/host/scripts",
    "packages/harness-acp/src",
    "src/plugin-sdk.ts",
    "src/harness-sdk.ts",
    "scripts",
    "*.config.ts",
    "apps/web/vite.config.ts"
  ]
}
